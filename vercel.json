{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "api/package.json"
    }
  },
  "rewrites": [
    { "source": "/api/admin/org-export-token", "destination": "/api/admin/org-webhook?tab=export-token" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
