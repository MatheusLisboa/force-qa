# Supabase (obrigatório)
VITE_SUPABASE_URL="https://bdvpzgrgwgcvfgflelbn.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_ANON_KEY_AQUI"

# Supabase service role — servidor (admin, convites, entrar em sala, APIs de IA)
SUPABASE_SERVICE_ROLE_KEY="SUA_SERVICE_ROLE_KEY_AQUI"

# Gemini AI (opcional — sugestões e duplicata; cai para OpenRouter se ausente)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI — OpenRouter (sugestão, duplicata e relatório executivo)
AI_PROVIDER="openrouter"

# OpenRouter (recomendado para produção — baixo custo)
OPENROUTER_API_KEY="SUA_OPENROUTER_KEY"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Ollama (local / sem custo de API)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
